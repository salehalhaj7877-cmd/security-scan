import requests

urls = [
    "https://example.com",
    "https://google.com",
    "https://facebook.com",
    "https://openai.com"
]

for url in urls:
    try:
        response = requests.get(url)
        if response.status_code == 200:
            print(f"{url} ✅ شغال - الكود: {response.status_code}")
        else:
            print(f"{url} ❌ مش شغال - الكود: {response.status_code}")
    except Exception as e:
        print(f"{url} ❌ خطأ: {e}")
